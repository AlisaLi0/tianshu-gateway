{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tianshu",
  "identifier": "io.github.alisali0.tianshu",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tianshu — Local LLM Gateway",
        "width": 1040,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
